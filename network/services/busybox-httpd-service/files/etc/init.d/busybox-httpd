#!/bin/sh /etc/rc.common
# Copyright (C) 2007-2021 OpenWrt.org
START=50
USE_PROCD=1

append_arg() {
	local cfg="$1"
	local var="$2"
	local opt="$3"
	local def="$4"
	local val

	config_get val "$cfg" "$var"
	[ -n "$val" -o -n "$def" ] && procd_append_param command "$opt" "${val:-$def}"
}

start_instance()
{
	local cfg="$1"
	local enabled
	config_get_bool enabled "$cfg" 'enabled' 1
	[ "$enabled" -gt 0 ] || return

	local realm="$(uci_get system.@system[0].hostname)"
	procd_open_instance "$cfg"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_set_param command /usr/sbin/httpd -f
	append_arg "$cfg" port "-p"
	append_arg "$cfg" home "-h"
	append_arg "$cfg" realm "-r" "${realm}"
	append_arg "$cfg" c_file "-c"
	procd_close_instance
}

service_triggers()
{
	procd_add_reload_trigger "httpd"
}

start_service() {
	mkdir -p /var/run/busybox-httpd/
	config_load httpd
	config_foreach start_instance httpd
}
